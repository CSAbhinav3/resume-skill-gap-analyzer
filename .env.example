TAXONOMY_IDS_PATH=data/taxonomy/skill_ids.json
SIMILARITY_THRESHOLD=0.75
MAX_MISSING_SKILLS=15
DEBUG=True
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here